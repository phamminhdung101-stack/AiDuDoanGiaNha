# ==============================================================================
# HOUSEPRICE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Hướng dẫn: Copy file này thành .env và điền các khóa cấu hình thực tế của bạn.
# LƯU Ý: Tuyệt đối không commit file .env (chứa API Key bí mật) lên GitHub!

# 1. Khóa bảo mật Flask Session
SECRET_KEY=houseai-secret-2024-change-in-prod

# 2. Google Maps Platform API Key
# Cần kích hoạt các dịch vụ sau trên Google Cloud Console (https://console.cloud.google.com):
#   - Maps JavaScript API (Bắt buộc để hiển thị bản đồ tương tác & markers)
#   - Geocoding API (Tùy chọn: Chuyển đổi địa chỉ chi tiết thành tọa độ Lat/Lng)
#   - Visualization Library (Tự động tải cho Heatmap Layer)
#
# Khuyến nghị bảo mật Google Cloud Console:
#   - Giới hạn Application Restrictions: HTTP referrers (ví dụ: http://localhost:5000/*, https://yourdomain.com/*)
#   - Giới hạn API Restrictions: Chỉ cho phép Maps JavaScript API và Geocoding API
#   - Đặt hạn mức ngân sách (Budget & Alerts) để tránh phát sinh chi phí ngoài ý muốn.
GOOGLE_MAPS_API_KEY=

# 3. Cấu hình Cơ sở dữ liệu MySQL (Tùy chọn)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=house_prediction
DB_PORT=3306

# 4. Cấu hình Chatbot AI Tư vấn Bất động sản (OpenAI API / OpenAI-compatible LLM)
# Lấy API Key tại: https://platform.openai.com/api-keys
# Có thể sử dụng bất kỳ nhà cung cấp tương thích OpenAI nào (OpenAI, Groq, DeepSeek, Ollama, v.v.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
